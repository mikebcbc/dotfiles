background-opacity = 0.95
macos-titlebar-style = tabs
background-blur-radius = 20
font-size = 14.0
font-family = "Inconsolata Nerd Font Mono"
# theme = "Catppuccin Macchiato"
# theme = "Kanagawa Wave"
# theme = "Ayu"
theme = Vesper
quick-terminal-position = "center"
mouse-hide-while-typing = true
window-padding-x = 0
window-padding-y = 0
clipboard-read = "allow"
clipboard-paste-protection = false
unfocused-split-opacity = 0.7
unfocused-split-fill = #2d2d2d

macos-option-as-alt = true

## Tabs
keybind = alt+t>n=new_tab
keybind = alt+t>l=next_tab
keybind = alt+t>h=previous_tab
keybind = alt+t>f=toggle_quick_terminal
keybind = alt+t>r=prompt_surface_title

## Splits
keybind = alt+p>n=new_split:auto
keybind = alt+p>d=new_split:down
keybind = alt+p>f=toggle_split_zoom
keybind = alt+l=goto_split:right
keybind = alt+j=goto_split:down
keybind = alt+k=goto_split:up
keybind = alt+h=goto_split:left
keybind = alt+shift+k=resize_split:up,10
keybind = alt+shift+j=resize_split:down,10
keybind = alt+shift+h=resize_split:left,10
keybind = alt+shift+l=resize_split:right,10

# Unbind so that cmd is used by OmniWM
keybind = cmd+h=unbind
keybind = cmd+j=unbind
keybind = cmd+k=unbind
keybind = cmd+l=unbind
keybind = cmd+shift+h=unbind
keybind = cmd+shift+j=unbind
keybind = cmd+shift+k=unbind
keybind = cmd+shift+l=unbind
keybind = cmd+t=unbind
keybind = cmd+w=unbind

## Keybinds for scrolling
keybind = cmd+shift+,=scroll_page_up
keybind = cmd+shift+m=scroll_page_down

## Weirdness with alt-backward and binding in neovim without this
keybind = alt+right=unbind
keybind = alt+left=unbind
keybind = alt+down=unbind
keybind = alt+up=unbind

# unbinds
keybind = cmd+d=unbind

# Features
link-url = true
auto-update = download
auto-update-channel = tip
font-feature = -calt
font-feature = -liga
font-feature = -dlig
window-save-state = always
