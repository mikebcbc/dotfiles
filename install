#!/usr/bin/env bash

set -e

DOTBOT_DIR="dotbot"
DOTBOT_BIN="bin/dotbot"
BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

cd "${BASEDIR}"
git -C "${DOTBOT_DIR}" submodule sync --quiet --recursive
git submodule update --init --recursive "${DOTBOT_DIR}"

# Shared config (both OS)
"${BASEDIR}/${DOTBOT_DIR}/${DOTBOT_BIN}" -d "${BASEDIR}" -c "install.conf.yaml" "${@}"

# OS-specific supplemental config
if [[ "$(uname)" == "Linux" ]]; then
    "${BASEDIR}/${DOTBOT_DIR}/${DOTBOT_BIN}" -d "${BASEDIR}" -c "install-linux.conf.yaml" "${@}"
elif [[ "$(uname)" == "Darwin" ]]; then
    "${BASEDIR}/${DOTBOT_DIR}/${DOTBOT_BIN}" -d "${BASEDIR}" -c "install-macos.conf.yaml" "${@}"
fi

# Package installation
"${BASEDIR}/scripts/install-packages.sh"

# Linux: sudo symlink Noctalia greeter config
if [[ "$(uname)" == "Linux" ]]; then
    [ -d /var/lib/noctalia-greeter ] && sudo ln -sfn "$(realpath "${BASEDIR}/noctalia/greeter.toml")" /var/lib/noctalia-greeter/greeter.toml || true
fi
