    {
      "description": "Omarchy-style: left Cmd+F is Super fullscreen (OmniWM). Ctrl+F stays Find via right-command remap.",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "f",
            "modifiers": {
              "mandatory": [
                "left_command"
              ],
              "optional": [
                "caps_lock"
              ]
            }
          },
          "to": [
            {
              "shell_command": "/opt/homebrew/bin/omniwmctl command toggle-fullscreen"
            }
          ]
        }
